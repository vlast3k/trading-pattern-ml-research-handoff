{
  "schema_version": 2,
  "purpose": "Configuration for scripts/run_strategy_family_triage.py. This ranks existing strategy-family evidence for the next practical validation decision.",
  "csv_include_globs": ["reports/**/*.csv", "*.csv"],
  "skip_path_patterns": [
    "selected_trades",
    "trades_nonoverlap",
    "trades_with_context",
    "raw_trades",
    "minute_bars",
    "bars_",
    "ohlcv_1m",
    "join_checks",
    "strategy_family_triage_"
  ],
  "family_patterns": {
    "donchian_range_breakout": ["donchian", "range_breakout", "range breakout", "breakout"],
    "macd_momentum": ["macd", "momentum"],
    "bollinger_volatility": ["bollinger", "bbands", "bb_", "volatility_expansion", "volatility expansion"],
    "ema_pullback": ["ema", "ema_pullback", "pullback"],
    "orb_vwap_prior_day": ["orb", "opening_range", "opening range", "vwap", "prior_day", "prior-day", "previous_day"],
    "multi_timeframe_regime_selector": ["multi_timeframe", "multi-timeframe", "mtf", "regime", "selector", "month_trend", "week_trend", "day_regime"]
  },
  "family_status_caps": {
    "ema_pullback": "diagnostic_only"
  },
  "required_promotion_metrics": [
    "net_dollars",
    "profit_factor",
    "max_drawdown_dollars",
    "trades",
    "largest_winner_share",
    "net_without_largest"
  ],
  "metric_aliases": {
    "net_dollars": ["net_dollars", "net", "net_pnl", "total_net", "total_net_dollars", "pnl", "pnl_dollars", "profit", "profit_dollars"],
    "profit_factor": ["profit_factor", "pf", "profitfactor"],
    "max_drawdown_dollars": ["max_drawdown_dollars", "max_dd", "max_drawdown", "drawdown", "dd"],
    "trades": ["trades", "trade_count", "num_trades", "n_trades", "count"],
    "largest_winner_share": ["largest_winner_share", "largest_share", "largest_win_share", "largest_winner_pct"],
    "net_without_largest": ["net_without_largest", "net_ex_largest", "net_after_largest_removed", "net_minus_largest"],
    "timeframe": ["timeframe", "tf", "minutes", "bar_minutes"],
    "variant": ["variant", "strategy", "strategy_id", "candidate_id", "monitor_id", "name"],
    "status": ["status", "classification", "verdict"]
  },
  "thresholds": {
    "min_trades_primary_validation": 50,
    "min_trades_research_monitor": 30,
    "min_profit_factor_primary_validation": 1.2,
    "min_profit_factor_research_monitor": 1.1,
    "max_largest_winner_share": 0.4,
    "min_net_without_largest": 0.0,
    "max_drawdown_one_contract_mnq": 3500.0,
    "preferred_max_drawdown_one_contract_mnq": 2000.0
  }
}
